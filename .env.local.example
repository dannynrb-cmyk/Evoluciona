# --- Necesarias para el asistente "Evo" (nunca deben empezar con NEXT_PUBLIC_,
# para que no se envíen al navegador) ---
# Llave de la API de Google Gemini (gratis en ai.google.dev)
GEMINI_API_KEY=

# Llave "service_role" de Supabase (Panel de Supabase -> Settings -> API ->
# "service_role" secret). Es distinta de la llave pública de arriba: esta
# nunca debe usarse en el navegador, solo aquí, en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Necesarias para los recordatorios de turno por Telegram ---
# Token del bot que creaste con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# Cualquier cadena secreta que tú inventes (para verificar que los mensajes
# realmente vengan de Telegram). Se configura también al registrar el
# webhook (ver instrucciones).
TELEGRAM_WEBHOOK_SECRET=
